{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run SQL file",
      "type": "shell",
      "command": "./run.sh",
      "args": ["${file}"],
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Make Markdown report",
      "type": "shell",
      "command": "./make-report.sh",
      "args": ["${file}"],
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    }
  ]
}
